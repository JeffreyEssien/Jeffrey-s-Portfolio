{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/publish-content.mjs --optional",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src components tests scripts playwright.config.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "content:snapshot": "node --env-file=.env.local scripts/publish-content.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "appwrite": "^25.0.0",
    "framer-motion": "^12.23.12",
    "next": "^15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-simple-typewriter": "^5.0.1",
    "swr": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.3.4",
    "node-appwrite": "^29.0.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
